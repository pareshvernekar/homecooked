// LoadEntityRelationships loads all configured entity relationships at startup before accepting requests.
func (c *cache) Init(tenantID string, config *CacheConfig) error {		
c.Data = make(map[string]Partition)
	if err := c.loadAllRelations(tenantID, config); err != nil { return err }
}

// LoadAllRelations loads all configured entity relationships at startup before accepting requests.
type AggressiveLoader struct {	cache Cache	enable bool
}
cachedEntry struct{	Data interface{}	AccessedAt time.Time	TTL time.Duration}

// Initialize loads all configured entity relationships at startup before accepting requests.
func (c *cache) Init(tenantID string, cfg *CacheConfig) error {
	if !cfg.CacheEnabled { return nil }
	p := c.partitionPath()
	for _, rel := range []string{"weekly_menus.food_details"} {	data, err := c.loadRelation(prel); if err != nil && data == nil { continue } 	// Track access for LRU eviction
}}